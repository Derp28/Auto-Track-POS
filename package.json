{
  "name": "auto-track-pos",
  "version": "0.2.0-stage2",
  "private": true,
  "license": "MIT",
  "author": "Chaz Aurin | Derp28 <chazvaurin0323@gmail.com>",
  "type": "module",
  "description": "Auto-Track POS: Express and PostgreSQL shop POS for a local shop network.",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --status",
    "bootstrap": "node scripts/bootstrap.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "test:browser": "node --test --test-concurrency=1 tests/browser.test.mjs",
    "test:workflows": "node --test --test-concurrency=1 tests/workflows.test.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "check": "node scripts/check-ui.mjs",
    "demo:build": "node scripts/build-demo.mjs",
    "verify": "node scripts/check-ui.mjs && node scripts/test-ui.mjs && node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}

# Auto-Track POS environment template (local MySQL edition).
# Copy to .env and fill in real values. Never commit .env.
# The app role needs DML only; the migrator role owns the schema and grants.
# Example (local MySQL 8.4 LTS on port 3307):
#   DATABASE_URL=mysql://autotrack_app:CHANGE_ME@127.0.0.1:3307/autotrack_local
#   MIGRATION_DATABASE_URL=mysql://autotrack_migrator:CHANGE_ME@127.0.0.1:3307/autotrack_local

NODE_ENV=development
PORT=3100
HOST=127.0.0.1
DATABASE_URL=mysql://autotrack_app:CHANGE_ME@127.0.0.1:3307/autotrack_local
MIGRATION_DATABASE_URL=mysql://autotrack_migrator:CHANGE_ME@127.0.0.1:3307/autotrack_local
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=20000

# One-time browser setup token. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Remove or rotate after the first administrator exists.
BOOTSTRAP_TOKEN=CHANGE_ME
ALLOW_SETUP=true

# Session behavior. Cookies are HttpOnly and SameSite=Strict.
SESSION_COOKIE_NAME=at_session
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=false

# LAN: bind to 0.0.0.0 only with TLS configured (or behind an HTTPS reverse proxy).
# HOST=0.0.0.0
# TLS_CERT_FILE=C:\AutoTrack\certs\server.crt
# TLS_KEY_FILE=C:\AutoTrack\certs\server.key
# COOKIE_SECURE=true
# TRUST_PROXY=false

# Isolated test-only option: allows plain HTTP on a non-loopback address.
# Never enable on a shop network.
ALLOW_INSECURE_LAN=false

LOG_REQUESTS=true

# Optional MySQL binary directory for backup/restore scripts. If unset, the scripts
# look in .runtime/mysql-8.4.13-winx64/bin and then PATH.
# MYSQL_BIN=C:\Program Files\MySQL\MySQL Server 8.4\bin

# Test database (used only by npm test; destructive tests never touch shop data).
TEST_DATABASE_URL=mysql://autotrack_app:CHANGE_ME@127.0.0.1:3307/autotrack_test_mysql
TEST_MIGRATION_DATABASE_URL=mysql://autotrack_migrator:CHANGE_ME@127.0.0.1:3307/autotrack_test_mysql

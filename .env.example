# Auto-Track POS environment template.
# Copy to .env and fill in real values. Never commit .env.
# The app role needs DML only; the migration role owns the schema.
# Example (local portable PostgreSQL on port 5433):
#   DATABASE_URL=postgres://autotrack_app:CHANGE_ME@127.0.0.1:5433/autotrack_dev
#   MIGRATION_DATABASE_URL=postgres://autotrack_owner:CHANGE_ME@127.0.0.1:5433/autotrack_dev

NODE_ENV=development
PORT=3100
HOST=127.0.0.1
DATABASE_URL=postgres://autotrack_app:CHANGE_ME@127.0.0.1:5433/autotrack_dev
MIGRATION_DATABASE_URL=postgres://autotrack_owner:CHANGE_ME@127.0.0.1:5433/autotrack_dev
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=20000

# One-time browser setup token. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Remove or rotate after the first administrator exists.
BOOTSTRAP_TOKEN=CHANGE_ME
ALLOW_SETUP=true

# Session behavior. Cookies are HttpOnly and SameSite=Strict.
SESSION_COOKIE_NAME=at_session
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=false

# LAN: bind to 0.0.0.0 only with TLS configured (or behind an HTTPS reverse proxy).
# HOST=0.0.0.0
# TLS_CERT_FILE=C:\AutoTrack\certs\server.crt
# TLS_KEY_FILE=C:\AutoTrack\certs\server.key
# COOKIE_SECURE=true
# TRUST_PROXY=false

# Isolated test-only option: allows plain HTTP on a non-loopback address.
# Never enable on a shop network.
ALLOW_INSECURE_LAN=false

LOG_REQUESTS=true

# Test database (used only by npm test; destructive tests never touch the dev database).
TEST_DATABASE_URL=postgres://autotrack_app:CHANGE_ME@127.0.0.1:5433/autotrack_test
TEST_MIGRATION_DATABASE_URL=postgres://autotrack_owner:CHANGE_ME@127.0.0.1:5433/autotrack_test
